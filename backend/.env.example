# Copy to .env and fill in. Never commit .env (it is git-ignored).

# =============================================================================
# VECTOR DATABASE - Qdrant Cloud free tier: https://cloud.qdrant.io
# Use the cluster's API endpoint, not the dashboard URL. It looks like:
#   https://<cluster-id>.<region>.<cloud>.cloud.qdrant.io:6333
# =============================================================================
QDRANT_URL=''
QDRANT_API_KEY=''
COLLECTION_NAME=siggraph2025_papers

# =============================================================================
# EMBEDDINGS - must always serve BAAI/bge-large-en-v1.5 (1024 dims)
# -----------------------------------------------------------------------------
# The vectors in Qdrant came from this exact model. A different embedding model
# is a different vector space: search will return nonsense while appearing to
# work, even if the dimensions happen to match.
#
#   local        free, no API key, ~42 ms/query, needs ~2.4 GB RAM
#                requires: pip install -r requirements-local.txt
#   huggingface  free tier, no credit card, negligible RAM -> use when deployed
#   openrouter   original assignment path, requires paid credits
# =============================================================================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Only needed when EMBEDDING_PROVIDER=huggingface
# Free token, no card: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=''

# =============================================================================
# LANGUAGE MODEL - answer generation and query refinement
# -----------------------------------------------------------------------------
#   cohere      free trial key, no card, 1,000 calls/month, 20 req/min
#               https://dashboard.cohere.com/api-keys
#   openrouter  requires paid credits: https://openrouter.ai/keys
# =============================================================================
LLM_PROVIDER=cohere
LLM_MODEL=command-a-03-2025
REFINEMENT_MODEL=command-r7b-12-2024

TEMPERATURE=0.1
MAX_TOKENS=2000

# =============================================================================
# RERANKING - Cohere, same free trial key as above
# Set RERANKER_TYPE=none or USE_RERANKER=false to disable.
# =============================================================================
RERANKER_TYPE=cohere
USE_RERANKER=true
COHERE_API_KEY=''

# =============================================================================
# RETRIEVAL
# =============================================================================
CHUNKS_PATH=./chunks.json
BM25_INDEX_PATH=./bm25_index.npz
RETRIEVAL_TOP_K=8
REFINE_QUERY=true

# LOW_MEMORY makes the backend fit a 512 MB host (Render free tier). It loads
# the prebuilt bm25_index.npz instead of parsing chunks.json and reads chunk
# payloads from Qdrant. Measured 157 MB with it, 631 MB without.
# Build the index first with: python build_bm25_index.py
LOW_MEMORY=false

# =============================================================================
# Only needed if you switch a provider above back to OpenRouter
# =============================================================================
OPENROUTER_API_KEY=''
